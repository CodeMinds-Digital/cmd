# Admin app (admin.codeminds.digital). Copy to admin/.env.local for local dev.
# Same Appwrite project as the site.
# NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
# NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_APPWRITE_DATABASE_ID=your-database-id
NEXT_PUBLIC_APPWRITE_PROJECT_NAME=cmd-website
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_DATABASE_ID=cmd_website_db

# Server-only. Scopes: sessions.write, users.read/write, teams.read/write,
# rows.read/write (audit log), tables.read. Never prefix with NEXT_PUBLIC_.
APPWRITE_API_KEY=standard_eb31556095c21234984a2b4a4881ac1728eb3c4238d4309a9ccb76fe53e4180ed68df876884375e8902da2119bd3682d09ebd148e9ad966bedb7ae7d9bd381f1ee1947d33313a1ba0782572add9b60063f5695ccfdcbc8cb78e9b0d2922bca092f554d0263b4edf7aaa9d11a9e6a8aceb85992645d70fe6d853acc1c8c890675


# Public URL of this app (password links in emails). Its host must be a Web
# platform in the Appwrite project.
ADMIN_URL=https://admin.codeminds.digital

# Public site (draft preview links) and the preview signing key (same value as the site's PREVIEW_SECRET).
SITE_URL=https://codeminds.digital
PREVIEW_SECRET=de2eb15e3dd674b35a71ef5baae3281126547becd63a8ebeec0ca29e027afce8
