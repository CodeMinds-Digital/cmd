/**
 * Generate docs/data/{schema,permissions,indexes}.md from appwrite.config.json
 * (run `npm run appwrite:pull` first so the snapshot is current).
 *
 *   npm run appwrite:docs
 *
 * The index catalogue maps every index to the query that uses it (QUERIES
 * below); an index with no entry is flagged "unused", one in QUERIES but not
 * live is flagged "missing".
 */
import { readFileSync, writeFileSync } from 'node:fs';

type Column = { key: string; type: string; size?: number; required: boolean; array?: boolean; format?: string; elements?: string[] };
type Table = { $id: string; name: string; $permissions: string[]; rowSecurity: boolean; columns: Column[]; indexes: { key: string; type: string; columns: string[]; orders?: string[] }[] };

const root = new URL('../../', import.meta.url);
const config = JSON.parse(readFileSync(new URL('appwrite.config.json', root), 'utf8')) as { tables: Table[]; buckets: { $id: string; $permissions: string[]; allowedFileExtensions: string[]; maximumFileSize: number; encryption: boolean; antivirus: boolean }[] };

/** index → what uses it (keep in sync when queries change). */
const QUERIES: Record<string, string> = {
  'caseStudy.by_slug': 'Unique address; slug clash check on save/publish (admin)',
  'caseStudy.by_order': 'Admin projects list (orderAsc orderIndex)',
  'caseStudy.by_state_order': 'Site: published projects in order (repository.loadCases)',
  'caseApproachStep.by_case_order': 'Children of a project (site + admin)',
  'caseScreen.by_case_order': 'Children of a project (site + admin)',
  'caseMetric.by_case_order': 'Children of a project (site + admin)',
  'journalPost.by_slug': 'Unique address; slug clash check (admin)',
  'journalPost.by_published_at': 'Admin journal list (orderDesc publishedAt)',
  'journalPost.by_state_published': 'Site: published posts, newest first (repository.loadPosts)',
  'testimonial.by_approved_order': 'Reserved for a testimonials section (not queried today)',
  'clientLogo.by_approved_order': 'Site: approved logos in order (repository.loadLogos)',
  'capability.by_state_order': 'Site: capabilities in order (repository.loadCapabilities)',
  'capabilityGroup.by_capability_order': 'Groups of the listed capabilities (site)',
  'processStep.by_state_order': 'Site: process steps in order (repository.loadProcess)',
  'stackItem.by_category_order': 'Stack strip grouped by category',
  'auditLog.by_created': 'Admin audit log, newest first',
  'auditLog.by_collection_doc': 'History of one item (by table + row)',
  'lead.by_status': 'Inbox status filter + counts',
  'lead.by_created': 'Inbox newest first; retention job ($updatedAt scan is small)',
  'contentDraft.by_target': 'One draft per item: lookup + uniqueness',
  'contentDraft.by_table_status': 'Drafts of a content type (admin lists, site preview)',
};

const typeOf = (c: Column) => {
  const base = c.format === 'enum' ? `enum(${(c.elements ?? []).join(' \\| ')})` : c.format ? c.format : c.type === 'string' ? `string ${c.size} (legacy)` : c.size ? `${c.type} ${c.size}` : c.type;
  return `${base}${c.array ? '[]' : ''}`;
};
const header = (title: string) => `# ${title}\n\n_Generated by \`npm run appwrite:docs\` from \`appwrite.config.json\`. Do not edit by hand._\n\n`;
const tables = [...config.tables].sort((a, b) => a.$id.localeCompare(b.$id));

// ── schema.md
let schema = header('Database schema (cmd_website_db)');
for (const t of tables) {
  schema += `## ${t.$id}\n\n${t.name}. Row security: ${t.rowSecurity ? 'on' : 'off'}.\n\n| Column | Type | Required |\n|---|---|---|\n`;
  for (const c of t.columns) schema += `| \`${c.key}\` | ${typeOf(c)} | ${c.required ? 'yes' : ''} |\n`;
  schema += '\n';
}
writeFileSync(new URL('docs/data/schema.md', root), schema);

// ── permissions.md
const who = (perms: string[], action: string) =>
  perms
    .filter((p) => p.startsWith(`${action}(`))
    .map((p) => p.slice(action.length + 2, -2).replace('team:', ''))
    .join(', ') || '—';
let perms = header('Permission matrix');
perms += 'Table-level permissions (row security is off everywhere). "—" = nobody except the server API key. Admin-only writes on live tables are what makes Appwrite itself refuse an Editor\'s publish (D24/D25).\n\n| Table | Create | Read | Update | Delete |\n|---|---|---|---|---|\n';
for (const t of tables) perms += `| ${t.$id} | ${who(t.$permissions, 'create')} | ${who(t.$permissions, 'read')} | ${who(t.$permissions, 'update')} | ${who(t.$permissions, 'delete')} |\n`;
perms += '\n## Storage\n\n| Bucket | Create | Read | Update | Delete | Types | Max | Encrypted | Antivirus |\n|---|---|---|---|---|---|---|---|---|\n';
for (const b of config.buckets) {
  perms += `| ${b.$id} | ${who(b.$permissions, 'create')} | ${who(b.$permissions, 'read')} | ${who(b.$permissions, 'update')} | ${who(b.$permissions, 'delete')} | ${b.allowedFileExtensions.join(', ')} | ${b.maximumFileSize / 1048576} MB | ${b.encryption ? 'yes' : 'no'} | ${b.antivirus ? 'yes' : 'no'} |\n`;
}
writeFileSync(new URL('docs/data/permissions.md', root), perms);

// ── indexes.md
let idx = header('Index catalogue');
idx += '| Index | Type | Columns | Used by |\n|---|---|---|---|\n';
const live = new Set<string>();
for (const t of tables) {
  for (const i of t.indexes) {
    const id = `${t.$id}.${i.key}`;
    live.add(id);
    idx += `| \`${id}\` | ${i.type} | ${i.columns.map((c, n) => `${c}${i.orders?.[n] === 'DESC' ? ' ↓' : ''}`).join(', ')} | ${QUERIES[id] ?? '**unused** — candidate to drop (needs confirmation)'} |\n`;
  }
}
const missing = Object.keys(QUERIES).filter((k) => !live.has(k));
if (missing.length) idx += `\n**Missing (expected but not live):** ${missing.join(', ')}\n`;
writeFileSync(new URL('docs/data/indexes.md', root), idx);

console.log(`Wrote schema.md (${tables.length} tables), permissions.md, indexes.md (${live.size} indexes, ${[...live].filter((k) => !QUERIES[k]).length} unused, ${missing.length} missing).`);
