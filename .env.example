# Email Configuration for Contact Form
# Copy this file to .env.local and fill in your actual values

# Gmail SMTP Configuration (recommended)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Alternative SMTP Configuration
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-email@domain.com
# SMTP_PASS=your-password

# Production URL (for SEO and social sharing)
NEXT_PUBLIC_SITE_URL=https://codeminds.digital

# ── Appwrite (server 2.x, TablesDB) ──────────────────────────────
# IDs and endpoint are public identifiers. Check with: npm run appwrite:check
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
NEXT_PUBLIC_APPWRITE_PROJECT_NAME=your-project-name
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your-database-id

# Server-only API key: never prefix with NEXT_PUBLIC_, never commit, never log.
# The deployed site needs ONLY rows.read + rows.write (check: npm run appwrite:check-key -- --role site).
# Your local scripts key (schema, backup, functions) is broader and never deployed. See docs/data/runbooks.md.
APPWRITE_API_KEY=

# Shared secret for HMAC-signed revalidation requests (/api/revalidate).
APPWRITE_WEBHOOK_SECRET=

# Server-only key for hashing enquiry IPs (generate: openssl rand -hex 32).
IP_HASH_SALT=

# Server-only key for signed draft-preview links (/api/preview); same value in the admin app.
# Generate: openssl rand -hex 32
PREVIEW_SECRET=
