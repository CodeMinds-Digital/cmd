/**
 * Snapshot the live Appwrite schema into the repo. Read-only on Appwrite.
 *
 *   npm run appwrite:pull
 *
 * Writes:
 *   appwrite.config.json                      CLI format (tablesDB, tables, buckets, teams), so
 *                                             `appwrite push tables` works once you run `appwrite login`
 *   packages/cms/src/schema/generated.ts      table IDs + typed row shapes
 *
 * Output is sorted and stripped of timestamps/status, so re-running against an
 * unchanged project produces no diff.
 */
import { writeFileSync } from 'node:fs';
import { Query, type Models } from 'node-appwrite';
import { createAdminClient } from '../../packages/cms/src/appwrite/server.ts';
import { retrying } from './retry.mts';

const root = new URL('../../', import.meta.url);
const admin = createAdminClient();
const env = admin.env;
const [tablesDB, storage, teams] = [retrying(admin.tablesDB), retrying(admin.storage), retrying(admin.teams)];

const VOLATILE = new Set(['$createdAt', '$updatedAt', 'status', 'error', '$sequence']);
const strip = <T extends object>(o: T) =>
  Object.fromEntries(Object.entries(o).filter(([k]) => !VOLATILE.has(k))) as Partial<T>;
const byId = <T extends { $id: string }>(a: T, b: T) => a.$id.localeCompare(b.$id);

const database = await tablesDB.get({ databaseId: env.databaseId });
const { tables } = await tablesDB.listTables({ databaseId: env.databaseId, queries: [Query.limit(100)] });
const { buckets } = await storage.listBuckets({ queries: [Query.limit(100)] });
const { teams: teamList } = await teams.list({ queries: [Query.limit(100)] });

type Column = Models.ColumnString & { elements?: string[]; relatedTable?: string };

const config = {
  projectId: env.projectId,
  endpoint: env.endpoint,
  tablesDB: [{ $id: database.$id, name: database.name, enabled: database.enabled }],
  tables: tables.sort(byId).map((t) => ({
    $id: t.$id,
    $permissions: t.$permissions,
    databaseId: env.databaseId,
    name: t.name,
    enabled: t.enabled,
    rowSecurity: t.rowSecurity,
    columns: (t.columns as Column[]).map(strip),
    indexes: t.indexes.map(strip),
  })),
  buckets: buckets.sort(byId).map((b) => ({
    $id: b.$id,
    $permissions: b.$permissions,
    fileSecurity: b.fileSecurity,
    name: b.name,
    enabled: b.enabled,
    maximumFileSize: b.maximumFileSize,
    allowedFileExtensions: b.allowedFileExtensions,
    compression: b.compression,
    encryption: b.encryption,
    antivirus: b.antivirus,
  })),
  teams: teamList.sort(byId).map((t) => ({ $id: t.$id, name: t.name })),
};
writeFileSync(new URL('appwrite.config.json', root), JSON.stringify(config, null, 2) + '\n');

// ── Types ────────────────────────────────────────────────────────────────
const pascal = (s: string) => s.replace(/(^|[_-])(\w)/g, (_, __, c: string) => c.toUpperCase());
function tsType(c: Column): string {
  const base =
    c.type === 'integer' || c.type === 'double' || c.type === 'float'
      ? 'number'
      : c.type === 'boolean'
        ? 'boolean'
        : (c.type === 'enum' || c.format === 'enum') && c.elements
          ? c.elements.map((e) => JSON.stringify(e)).join(' | ')
          : 'string';
  return c.array ? `Array<${base}>` : base;
}

let ts = `// Generated by scripts/appwrite/pull-schema.mts from the live project. Do not edit.\n`;
ts += `import type { Models } from 'node-appwrite';\n\n`;
ts += `export const DATABASE_ID = ${JSON.stringify(env.databaseId)};\n\n`;
ts += `export const TABLES = {\n${config.tables.map((t) => `  ${t.$id}: ${JSON.stringify(t.$id)},`).join('\n')}\n} as const;\n`;
ts += `export type TableId = (typeof TABLES)[keyof typeof TABLES];\n`;
for (const t of tables) {
  ts += `\nexport type ${pascal(t.$id)}Row = Models.Row & {\n`;
  for (const c of t.columns as Column[]) {
    const optional = c.required ? '' : ' | null';
    ts += `  ${c.key}: ${tsType(c)}${optional};\n`;
  }
  ts += `};\n`;
}
writeFileSync(new URL('packages/cms/src/schema/generated.ts', root), ts);

console.log(`Pulled ${config.tables.length} tables, ${config.buckets.length} buckets, ${config.teams.length} teams from database "${env.databaseId}".`);
